# Supabase Postgres — use the "Transaction pooler" connection string (port 6543).
# URL-encode any special characters in the password (@ -> %40, etc).
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Only needed if/when we use Supabase Storage for delivery proof photos/signatures.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
